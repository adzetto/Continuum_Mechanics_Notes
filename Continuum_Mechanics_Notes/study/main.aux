\@writefile{lof}{\contentsline {figure}{\numberline {F}{\ignorespaces Problem 4, on a diametral section. Every point moves along its own radius, so $A\le R\le B$ goes to $a\le r\le b$ with $a=\lambda (A)A$, $b=\lambda (B)B$. The element shows the two stretches, $\mathrm  {d}R\DOTSB \mapstochar \rightarrow (\lambda R)'\mathrm  {d}R$ and $R\,\mathrm  {d}\Theta \DOTSB \mapstochar \rightarrow \lambda R\,\mathrm  {d}\Theta $; with the second, equal, tangential stretch, $J=\lambda ^{2}(\lambda R)'$.}}{186}{figure.832}\protected@file@percent }
\newlabel{fig:sphdef}{{F}{186}{Problem 4, on a diametral section. Every point moves along its own radius, so $A\le R\le B$ goes to $a\le r\le b$ with $a=\lambda (A)A$, $b=\lambda (B)B$. The element shows the two stretches, $\dl R\mapsto (\lambda R)'\dl R$ and $R\,\dl \Theta \mapsto \lambda R\,\dl \Theta $; with the second, equal, tangential stretch, $J=\lambda ^{2}(\lambda R)'$}{figure.832}{}}
\@writefile{toc}{\contentsline {subsection}{Problem 5: Telescopic, or anti-plane, shear}{187}{problemenv.833}\protected@file@percent }
