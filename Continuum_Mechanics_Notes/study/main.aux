\newlabel{rem:sphscale}{{1.110}{62}{the three scale factors, read off the picture}{theorem.235}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.1}{\ignorespaces Left: the spherical frame at $\vek  {x}=r\vek  {e}_{\rho }$. The heavy circle is the parallel of latitude $\varphi $, and its radius is the dashed distance $r\cos \varphi $ from the polar axis, not $r$; this single fact is the whole reason $h_{\theta }=r\cos \varphi $. The triad $\{\vek  {e}_{\rho },\vek  {e}_{\theta },\vek  {e}_{\varphi }\}$ points outward, east and north, and $\vek  {e}_{\theta }$ appears short only because it is foreshortened, pointing towards the reader. Right: the box built on the three coordinate increments, with edge lengths $\mathrm  {d}r$, $r\cos \varphi \,\mathrm  {d}\theta $ and $r\,\mathrm  {d}\varphi $; each edge is a coordinate increment multiplied by its scale factor.}}{63}{figure.234}\protected@file@percent }
\newlabel{fig:sph}{{1.1}{63}{Left: the spherical frame at $\bx =r\berho $. The heavy circle is the parallel of latitude $\varphi $, and its radius is the dashed distance $r\cos \varphi $ from the polar axis, not $r$; this single fact is the whole reason $h_{\theta }=r\cos \varphi $. The triad $\{\berho ,\beth ,\beph \}$ points outward, east and north, and $\beth $ appears short only because it is foreshortened, pointing towards the reader. Right: the box built on the three coordinate increments, with edge lengths $\dl r$, $r\cos \varphi \,\dl \theta $ and $r\,\dl \varphi $; each edge is a coordinate increment multiplied by its scale factor}{figure.234}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.2}{\ignorespaces A meridional section, showing why $h_{\theta }=r\cos \varphi $ while $h_{\varphi }=r$. Since $\varphi $ is measured from the equator, the point is at distance $r$ from the origin but only $\varrho =r\cos \varphi $ from the polar axis. A change of longitude sweeps it around that smaller circle, a change of latitude along a meridian of radius $r$. The azimuthal direction $\vek  {e}_{\theta }$ comes out of the page, marked by the circled dot.}}{64}{figure.236}\protected@file@percent }
\newlabel{fig:sphscale}{{1.2}{64}{A meridional section, showing why $h_{\theta }=r\cos \varphi $ while $h_{\varphi }=r$. Since $\varphi $ is measured from the equator, the point is at distance $r$ from the origin but only $\varrho =r\cos \varphi $ from the polar axis. A change of longitude sweeps it around that smaller circle, a change of latitude along a meridian of radius $r$. The azimuthal direction $\beth $ comes out of the page, marked by the circled dot}{figure.236}{}}
