\@writefile{lof}{\contentsline {figure}{\numberline {5.1}{\ignorespaces Evolution of a non-material region. In time $\varepsilon $ the boundary advances a distance $u\varepsilon $ along its own normal, so the shell swept out has volume measure $\mathrm  {d}v=u\varepsilon \,\mathrm  {d}a+o(\varepsilon )$ over each element $\mathrm  {d}a$ of $\partial V(t)$. Dividing by $\varepsilon $ and letting $\varepsilon \to 0$ leaves $\DOTSI \intop \ilimits@ _{\partial V}\varphi u\,\mathrm  {d}a$: only the normal motion of the boundary contributes, since sliding the boundary along itself sweeps no volume.}}{253}{figure.1023}\protected@file@percent }
\newlabel{fig:ch5nonmat}{{5.1}{253}{Evolution of a non-material region. In time $\eps $ the boundary advances a distance $u\eps $ along its own normal, so the shell swept out has volume measure $\dl v=u\eps \,\dl a+o(\eps )$ over each element $\dl a$ of $\partial V(t)$. Dividing by $\eps $ and letting $\eps \to 0$ leaves $\int _{\partial V}\varphi u\,\dl a$: only the normal motion of the boundary contributes, since sliding the boundary along itself sweeps no volume}{figure.1023}{}}
