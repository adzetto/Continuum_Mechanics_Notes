\@writefile{toc}{\contentsline {subsection}{Problem 2(b): the Piola identity.}{99}{section*.477}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2.14}{\ignorespaces The Piola identity. A closed material surface stays closed, so its normals integrate to zero in $\kappa _{t}$ as they do in $\kappa $. By Piola--Nanson \eqr  {2.54} that is the divergence theorem applied to $\vek  {F}^{*}$, and it holds for every $P$ and every motion only if $\operatorname  {Div}\vek  {F}^{*}=\vek  {0}$.}}{100}{figure.479}\protected@file@percent }
\newlabel{fig:piola}{{2.14}{100}{The Piola identity. A closed material surface stays closed, so its normals integrate to zero in $\kappa _{t}$ as they do in $\kappa $. By Piola--Nanson \eqr {2.54} that is the divergence theorem applied to $\bF ^{*}$, and it holds for every $P$ and every motion only if $\Dvg \bF ^{*}=\bze $}{figure.479}{}}
