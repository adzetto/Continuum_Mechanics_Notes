\@writefile{toc}{\contentsline {subsection}{Problem 10: Circular flow}{234}{problemenv.949}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {F}{\ignorespaces Problem 10, at one point $P$ of a circular streamline, with the two material fibres as they stand now shown dashed. In rigid rotation both turn at the same rate, so their mean rate, the vorticity, is $f$ and their relative rate, the shearing, is zero. In the potential vortex $f=k/r^{2}$ the two rates are equal and opposite: the mean vanishes, so a paddle wheel placed at $P$ would circle the origin without ever turning, yet the right angle between the fibres opens at rate $2f$, so the material is being sheared throughout. Curved streamlines therefore say nothing about vorticity.}}{236}{figure.950}\protected@file@percent }
\newlabel{fig:vortex}{{F}{236}{Problem 10, at one point $P$ of a circular streamline, with the two material fibres as they stand now shown dashed. In rigid rotation both turn at the same rate, so their mean rate, the vorticity, is $f$ and their relative rate, the shearing, is zero. In the potential vortex $f=k/r^{2}$ the two rates are equal and opposite: the mean vanishes, so a paddle wheel placed at $P$ would circle the origin without ever turning, yet the right angle between the fibres opens at rate $2f$, so the material is being sheared throughout. Curved streamlines therefore say nothing about vorticity}{figure.950}{}}
